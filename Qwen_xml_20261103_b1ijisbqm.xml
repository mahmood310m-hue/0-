<!-- activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/primary" android:gravity="center_vertical" android:padding="8dp" android:orientation="horizontal">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_school" app:tint="@android:color/white" android:layout_marginEnd="12dp"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <TextView android:id="@+id/marqueeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مرحباً بكم في مدرسة كوثر الأهلية المختلطة  ✨  التميز والإبداع  ✨  عام دراسي موفق  ✨" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" android:singleLine="true"/>
        </HorizontalScrollView>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="true">
            
            <androidx.cardview.widget.CardView android:id="@+id/cardTopStudents" android:layout_width="0dp" android:layout_height="160dp" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_margin="8dp" android:clickable="true" android:foreground="?selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/card_blue">
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_star" app:tint="@color/primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الطلاب المتفوقون" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/primary" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/cardNews" android:layout_width="0dp" android:layout_height="160dp" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_margin="8dp" android:clickable="true" android:foreground="?selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/card_purple">
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_news" app:tint="#7B1FA2"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الأخبار والفعاليات" android:textSize="15sp" android:textStyle="bold" android:textColor="#7B1FA2" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/cardSchedule" android:layout_width="0dp" android:layout_height="160dp" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_margin="8dp" android:clickable="true" android:foreground="?selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/card_green">
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_schedule" app:tint="#388E3C"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الجدول المدرسي" android:textSize="15sp" android:textStyle="bold" android:textColor="#388E3C" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/cardAbout" android:layout_width="0dp" android:layout_height="160dp" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_margin="8dp" android:clickable="true" android:foreground="?selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/card_orange">
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_info" app:tint="#F57C00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عن المدرسة" android:textSize="15sp" android:textStyle="bold" android:textColor="#F57C00" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>
    </ScrollView>
</LinearLayout>